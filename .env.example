# ==============================================================================
# DAY 7: RETRIEVAL & CONTEXT ENGINEERING - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. API Keys (Điền ít nhất 1 key bạn sử dụng)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Embedding Model (Kế thừa chuẩn Day 6: 1536 chiều vector)
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSION=1536

# 3. Vector Store Options
# - local: Lưu và nạp vector từ data/embeddings_cache.json (nhẹ, nhanh, không cần docker)
# - pgvector: Kết nối PostgreSQL pgvector từ container Day 6
VECTOR_STORE_TYPE=local
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab
EMBEDDINGS_CACHE_PATH=data/embeddings_cache.json

# 4. LLM Configuration for Agent (Giai đoạn 4)
# Provider options: openrouter | openai | gemini
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
